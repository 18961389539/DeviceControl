{
  "profileId": "DEMO-DUAL-STATION",
  "driver": "Simulation",
  "signals": [
    {
      "name": "PartPresent",
      "direction": "DI",
      "channel": "DI0",
      "description": "产品到位",
      "initial": true,
      "injectable": true
    },
    {
      "name": "GuardClosed",
      "direction": "DI",
      "channel": "DI1",
      "description": "普通防护门状态（非安全）",
      "initial": true,
      "injectable": true
    },
    {
      "name": "AirPressureOk",
      "direction": "DI",
      "channel": "DI2",
      "description": "气压正常",
      "initial": true,
      "injectable": true
    },
    {
      "name": "ClampExtended",
      "direction": "DI",
      "channel": "DI3",
      "description": "夹紧气缸伸出到位",
      "initial": false
    },
    {
      "name": "ClampRetracted",
      "direction": "DI",
      "channel": "DI4",
      "description": "夹紧气缸缩回到位",
      "initial": true
    },
    {
      "name": "StopperExtended",
      "direction": "DI",
      "channel": "DI5",
      "description": "阻挡气缸伸出到位",
      "initial": false
    },
    {
      "name": "StopperRetracted",
      "direction": "DI",
      "channel": "DI6",
      "description": "阻挡气缸缩回到位",
      "initial": true
    },
    {
      "name": "ClampExtend",
      "direction": "DO",
      "channel": "DO0",
      "description": "夹紧伸出电磁阀"
    },
    {
      "name": "ClampRetract",
      "direction": "DO",
      "channel": "DO1",
      "description": "夹紧缩回电磁阀"
    },
    {
      "name": "StopperExtend",
      "direction": "DO",
      "channel": "DO2",
      "description": "阻挡伸出电磁阀"
    },
    {
      "name": "StopperRetract",
      "direction": "DO",
      "channel": "DO3",
      "description": "阻挡缩回电磁阀"
    }
  ],
  "axes": [
    {
      "id": "X",
      "label": "X 定位轴",
      "minMm": 0,
      "maxMm": 200,
      "homeMm": 0,
      "speedMmPerSec": 100
    },
    {
      "id": "Y",
      "label": "Y 工艺轴",
      "minMm": 0,
      "maxMm": 150,
      "homeMm": 0,
      "speedMmPerSec": 85
    }
  ],
  "cylinders": [
    {
      "id": "Clamp",
      "label": "夹紧气缸",
      "extendOutput": "ClampExtend",
      "retractOutput": "ClampRetract",
      "extendedInput": "ClampExtended",
      "retractedInput": "ClampRetracted",
      "timeoutMs": 1800
    },
    {
      "id": "Stopper",
      "label": "阻挡气缸",
      "extendOutput": "StopperExtend",
      "retractOutput": "StopperRetract",
      "extendedInput": "StopperExtended",
      "retractedInput": "StopperRetracted",
      "timeoutMs": 1800
    }
  ],
  "interlocks": [
    {
      "action": "AxisMove",
      "device": "*",
      "signal": "ClampRetracted",
      "required": true,
      "message": "移动轴前夹紧气缸必须缩回"
    },
    {
      "action": "AxisMove",
      "device": "*",
      "signal": "StopperRetracted",
      "required": true,
      "message": "移动轴前阻挡气缸必须缩回"
    },
    {
      "action": "CylinderExtend",
      "device": "Clamp",
      "signal": "StopperExtended",
      "required": true,
      "message": "夹紧前阻挡气缸必须伸出"
    }
  ],
  "sequence": [
    {
      "type": "WaitInput",
      "label": "等待产品到位",
      "device": "PartPresent",
      "timeoutMs": 2000,
      "id": "part"
    },
    {
      "type": "VisionLocate",
      "label": "视觉定位",
      "id": "vision",
      "onError": "Retry",
      "maxRetries": 1,
      "sharedResources": [
        "CELL-SHARED"
      ],
      "resourceWaitTimeoutMs": 2500
    },
    {
      "id": "xy-approach",
      "type": "Parallel",
      "label": "X/Y 双轴并行定位",
      "children": [
        {
          "type": "AxisMove",
          "label": "X 轴视觉定位",
          "device": "X",
          "useVisionX": true,
          "id": "x-place"
        },
        {
          "type": "AxisMove",
          "label": "Y 轴工艺定位",
          "device": "Y",
          "positionMm": 40,
          "id": "y-place"
        }
      ]
    },
    {
      "type": "CylinderExtend",
      "label": "阻挡气缸伸出",
      "device": "Stopper",
      "id": "stopper-extend"
    },
    {
      "type": "CylinderExtend",
      "label": "夹紧气缸伸出",
      "device": "Clamp",
      "id": "clamp-extend"
    },
    {
      "type": "Delay",
      "label": "工艺保持",
      "durationMs": 250,
      "id": "dwell"
    },
    {
      "type": "CylinderRetract",
      "label": "夹紧气缸缩回",
      "device": "Clamp",
      "id": "clamp-retract"
    },
    {
      "type": "CylinderRetract",
      "label": "阻挡气缸缩回",
      "device": "Stopper",
      "id": "stopper-retract"
    },
    {
      "id": "xy-return",
      "type": "Parallel",
      "label": "X/Y 双轴并行复归",
      "children": [
        {
          "type": "AxisMove",
          "label": "Y 轴返回等待位",
          "device": "Y",
          "positionMm": 0,
          "id": "y-return"
        },
        {
          "type": "AxisMove",
          "label": "X 轴返回等待位",
          "device": "X",
          "positionMm": 0,
          "id": "x-return"
        }
      ]
    }
  ],
  "flowVersion": "flow-v0.5.0"
}
